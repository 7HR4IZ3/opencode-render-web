# Required: OpenCode refuses to start without a server password.
OPENCODE_SERVER_PASSWORD=replace-with-a-long-random-password

# Base64 of the auth.json file used by OpenCode providers.
# Generate locally with: base64 < auth.json | tr -d '\n'
OPENCODE_AUTH_B64=

# Use a file-backed SQLite DB locally too. Set Litestream to 1 to restore and
# replicate this file through the configured S3-compatible R2 bucket.
OPENCODE_DB=/var/lib/opencode/opencode.db
OPENCODE_LITESTREAM_ENABLED=0

# Optional GitLab REST fallback credentials. The native GitLab MCP uses OAuth.
GITLAB_TOKEN=
GITLAB_URL=https://gitlab.com

# Cloudflare R2 S3-compatible API settings.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=opencode
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_SESSION_TOKEN=
R2_REGION=auto
R2_PREFIX=opencode

# Optional limits for the R2 tools.
R2_MAX_BYTES=4194304

# Set to 1 to hydrate and continuously synchronize the native workspace.
# The default conflict policy is safe: conflicting local/remote changes are
# left untouched and reported by r2_sync_status.
R2_SYNC_ENABLED=0
R2_SYNC_PREFIX=workspace
R2_SYNC_INTERVAL_MS=5000
R2_SYNC_DEBOUNCE_MS=750
R2_SYNC_CONFLICT=skip
R2_SYNC_CONFLICT_PREFIX=workspace-conflicts
R2_SYNC_IGNORE=.r2-sync,.opencode,.git,node_modules
R2_SYNC_MAX_FILE_BYTES=33554432
R2_SYNC_MAX_FILES=2000
R2_SYNC_MAX_TOTAL_BYTES=268435456
