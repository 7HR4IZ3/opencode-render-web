# syntax=docker/dockerfile:1.7

# Vercel Container Images run as autoscaling Functions. This is an isolated,
# ephemeral preview of the same OpenCode build used by the Render deployment.
FROM oven/bun:1.4.0-alpine AS plugin-deps
WORKDIR /opt/opencode-config/.opencode
COPY .opencode/package.json .opencode/bun.lock ./
RUN bun install --frozen-lockfile --production

FROM litestream/litestream:0.5.16-scratch AS litestream

FROM ghcr.io/anomalyco/opencode:2.0.3@sha256:aaf8c5420e10652c520e068532384f6e20cece2922c404db7f89e36720b9f212

USER root
RUN apk add --no-cache ca-certificates git socat nginx su-exec \
  && addgroup -S opencode \
  && adduser -S -G opencode -h /tmp/opencode opencode \
  && mkdir -p /opt/opencode-config \
  && chown opencode:opencode /opt/opencode-config

COPY --chmod=755 docker/entrypoint.sh /usr/local/bin/opencode-render-entrypoint
COPY --chmod=755 docker/vercel-entrypoint.sh /usr/local/bin/opencode-vercel-entrypoint
COPY --from=litestream /usr/local/bin/litestream /usr/local/bin/litestream
COPY opencode.jsonc /opt/opencode-config/opencode.jsonc
COPY --from=plugin-deps --chown=opencode:opencode /opt/opencode-config/.opencode/node_modules /opt/opencode-config/.opencode/node_modules
COPY --chown=opencode:opencode .opencode/package.json .opencode/bun.lock /opt/opencode-config/.opencode/
COPY --chown=opencode:opencode .opencode/plugins /opt/opencode-config/.opencode/plugins

# Only /tmp is writable in a Function. Its contents disappear on scale-down.
# The root entrypoint binds Vercel's default port 80, then runs OpenCode as the
# unprivileged opencode user on port 3000.
ENV HOME=/tmp/opencode \
  XDG_DATA_HOME=/tmp/opencode \
  XDG_CONFIG_HOME=/tmp/opencode/config \
  XDG_STATE_HOME=/tmp/opencode/state \
  OPENCODE_DB=/tmp/opencode/opencode.db \
  OPENCODE_INTERNAL_PORT=4096 \
  OPENCODE_WORKDIR=/tmp/opencode/workspace \
  OPENCODE_LITESTREAM_ENABLED=0 \
  R2_SYNC_ENABLED=0 \
  API_PORT=4097

EXPOSE 80
ENTRYPOINT ["/usr/local/bin/opencode-vercel-entrypoint"]
