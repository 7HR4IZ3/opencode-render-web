{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "port_proxy_expose_port", "resource": "*", "effect": "ask" },
    { "action": "port_proxy_unexpose_port", "resource": "*", "effect": "ask" }
  ],
  "mcp": {
    "servers": {
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/x/all",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}"
        }
      },
      "render": {
        "type": "remote",
        "url": "https://mcp.render.com/mcp",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:RENDER_API_KEY}"
        }
      },
      "vercel_mcp": {
        "type": "remote",
        "url": "{env:VERCEL_MCP_URL}"
      },
      "gitlab_mcp": {
        "type": "remote",
        "url": "{env:GITLAB_MCP_URL}",
        "headers": {
          "X-Gitlab-Mcp-Server-Tool-Name-Prefix": "gitlab_",
          "X-Gitlab-Enabled-Mcp-Server-Toolsets": "all"
        }
      }
    }
  }
}
